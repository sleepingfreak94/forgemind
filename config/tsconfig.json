{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "rootDir": "..",
    "outDir": "../dist",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["../src/**/*.ts", "../tests/**/*.ts"]
}
